---
import Base from '../layouts/Base.astro';
---
<Base title="Not found · RAG Complete Book">
  <main class="wrap">
    <p class="code">404 — output: no matching page</p>
    <h1>That page didn't retrieve.</h1>
    <p>Even hybrid search has misses. <a href="/">Back to the book →</a></p>
  </main>
</Base>

<style>
  .wrap { max-width: 640px; margin: 0 auto; padding: 7rem 1.4rem; }
  .code { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--jade); }
  h1 { font-family: var(--serif); font-size: 2.2rem; margin: 0.6rem 0 0.8rem; }
  p { color: var(--ink-dim); }
</style>
